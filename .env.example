# Copy to .env.local (never commit it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Database: local file in dev. On Vercel use Turso (libsql://...) + token; without DATABASE_URL Vercel falls back to /tmp (ephemeral).
# turso db create bandari-check; turso db show bandari-check --url; turso db tokens create bandari-check
DATABASE_URL=file:./data/bandari.db
DATABASE_AUTH_TOKEN=
# Set to require HTTP basic auth (any username) for the whole app. Strongly recommended when deployed.
BASIC_AUTH_PASS=
# In production the app returns 503 unless BASIC_AUTH_PASS is set. Set to 1 only for an intentionally public demo.
ALLOW_PUBLIC=
DEMURRAGE_USD_PER_DAY=75
AUDIT_RATE_PER_MIN=6
MAX_FILE_MB=8
RETENTION_DAYS=30
