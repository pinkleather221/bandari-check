{
  "permissions": {
    "allow": ["Bash(npm run *)", "Bash(npm test)", "Bash(npm install)", "Bash(npx tsx *)", "Bash(npx vitest *)", "Bash(node scripts/*)", "Bash(git status)", "Bash(git diff *)", "Bash(git add *)", "Bash(git commit *)"],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./data/*.db)", "Bash(rm -rf *)", "Bash(curl *)"]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cat MEMORY.md" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node scripts/memory-guard.mjs" }] }]
  }
}
